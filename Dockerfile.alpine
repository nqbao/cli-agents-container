# syntax=docker/dockerfile:1
# Multi-stage Dockerfile for AI Tools on Alpine Linux (musl libc)
# Packages: @openai/codex, @anthropic-ai/claude-code, @google/gemini-cli, opencode, @github/copilot, @earendil-works/pi-coding-agent, antigravity-cli
# Platform: linux/amd64, linux/arm64

FROM alpine:latest AS builder

# Build arguments for multi-platform support
ARG TARGETARCH

# Environment variables
# NPM_CONFIG_PREFIX: install global npm packages under /usr/local like the other variants
# USE_BUILTIN_RIPGREP: Claude Code's bundled ripgrep is glibc-only; use the apk one
ENV NODE_ENV=production \
    NPM_CONFIG_PREFIX=/usr/local \
    USE_BUILTIN_RIPGREP=0

# Install system packages, developer utilities and GitHub CLI from Alpine repos
# libgcc/libstdc++ are required by the Claude Code native binary on musl
RUN apk add --no-cache \
        bash \
        ca-certificates \
        curl \
        git \
        wget \
        xz \
        unzip \
        libgcc \
        libstdc++ \
        ripgrep \
        fd \
        make \
        jq \
        shellcheck \
        github-cli

# Install ast-grep from Alpine repos (upstream only publishes glibc builds)
# The apk package ships only `ast-grep`; add the `sg` alias the other variants have
RUN apk add --no-cache ast-grep && \
    ln -s /usr/bin/ast-grep /usr/local/bin/sg

# Install Node.js from Alpine repos (nodejs.org only publishes glibc builds)
# Pi requires Node >= 22.19
RUN apk add --no-cache nodejs npm && \
    node --version && npm --version && \
    node -e 'const [a,b]=process.versions.node.split(".").map(Number); process.exit(a>22||(a===22&&b>=19)?0:1)'

ARG CACHEBUST

# Install yq from GitHub releases
RUN TARGETARCH_VAL=$([ "$TARGETARCH" = "amd64" ] && echo "amd64" || echo "arm64") && \
    YQ_TAG=$(curl -fsSL -o /dev/null -w '%{url_effective}' \
        "https://github.com/mikefarah/yq/releases/latest" | sed 's|.*/||') && \
    echo "Installing yq ${YQ_TAG}" && \
    curl -fsSL "https://github.com/mikefarah/yq/releases/download/${YQ_TAG}/yq_linux_${TARGETARCH_VAL}" \
        -o /usr/local/bin/yq && \
    chmod +x /usr/local/bin/yq

# Install glab (GitLab CLI) from GitLab releases
RUN TARGETARCH_VAL=$([ "$TARGETARCH" = "amd64" ] && echo "amd64" || echo "arm64") && \
    GLAB_VERSION=$(curl -fsSL "https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/releases?per_page=1" | \
        jq -r '.[0].tag_name | ltrimstr("v")') && \
    echo "Installing glab v${GLAB_VERSION}" && \
    curl -fsSL "https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/packages/generic/glab/${GLAB_VERSION}/glab_${GLAB_VERSION}_linux_${TARGETARCH_VAL}.tar.gz" | \
    tar -xz -C /usr/local/bin --strip-components=1 bin/glab && \
    chmod +x /usr/local/bin/glab

# Install kubectl from official release
RUN TARGETARCH_VAL=$([ "$TARGETARCH" = "amd64" ] && echo "amd64" || echo "arm64") && \
    KUBECTL_VERSION=$(curl -fsSL "https://dl.k8s.io/release/stable.txt") && \
    echo "Installing kubectl ${KUBECTL_VERSION}" && \
    curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH_VAL}/kubectl" \
        -o /usr/local/bin/kubectl && \
    chmod +x /usr/local/bin/kubectl

# Install stern (multi-pod log tailing) from GitHub releases
RUN TARGETARCH_VAL=$([ "$TARGETARCH" = "amd64" ] && echo "amd64" || echo "arm64") && \
    STERN_TAG=$(curl -fsSL -o /dev/null -w '%{url_effective}' \
        "https://github.com/stern/stern/releases/latest" | sed 's|.*/||') && \
    STERN_VERSION=${STERN_TAG#v} && \
    echo "Installing stern ${STERN_TAG}" && \
    curl -fsSL "https://github.com/stern/stern/releases/download/${STERN_TAG}/stern_${STERN_VERSION}_linux_${TARGETARCH_VAL}.tar.gz" | \
    tar -xz -C /usr/local/bin stern && \
    chmod +x /usr/local/bin/stern

# Install npm-based AI tools globally
RUN npm install -g \
    @openai/codex \
    @google/gemini-cli \
    @github/copilot \
    @earendil-works/pi-coding-agent && \
    npm cache clean --force

# Install Claude Code via official install script (detects musl)
RUN curl -fsSL https://claude.ai/install.sh | bash && \
    cp /root/.local/bin/claude /usr/local/bin/claude && \
    chmod +x /usr/local/bin/claude && \
    claude --version

# Install Antigravity CLI (agy, successor to Gemini CLI) via official install script
RUN curl -fsSL https://antigravity.google/cli/install.sh | bash && \
    cp /root/.local/bin/agy /usr/local/bin/agy && \
    chmod +x /usr/local/bin/agy && \
    agy --version

# Install OpenCode from GitHub releases (musl binary, latest version)
RUN if [ "$TARGETARCH" = "amd64" ]; then \
        OPENCODE_ARCH="x64"; \
    elif [ "$TARGETARCH" = "arm64" ]; then \
        OPENCODE_ARCH="arm64"; \
    else \
        echo "Unsupported architecture: $TARGETARCH" && exit 1; \
    fi && \
    OPENCODE_TAG=$(curl -fsSL -o /dev/null -w '%{url_effective}' \
        "https://github.com/anomalyco/opencode/releases/latest" | sed 's|.*/||') && \
    echo "Installing opencode ${OPENCODE_TAG}" && \
    curl -fsSL "https://github.com/anomalyco/opencode/releases/download/${OPENCODE_TAG}/opencode-linux-${OPENCODE_ARCH}-musl.tar.gz" | \
    tar -xz -C /usr/local/bin && \
    chmod +x /usr/local/bin/opencode

# Install paco (Paco AI code reviewer CLI) from GitHub releases
RUN TARGETARCH_VAL=$([ "$TARGETARCH" = "amd64" ] && echo "amd64" || echo "arm64") && \
    PACO_TAG=$(curl -fsSL -o /dev/null -w '%{url_effective}' \
        "https://github.com/pipelines-as-code/paco-cli/releases/latest" | sed 's|.*/||') && \
    PACO_VERSION=${PACO_TAG#v} && \
    echo "Installing paco ${PACO_TAG}" && \
    curl -fsSL "https://github.com/pipelines-as-code/paco-cli/releases/download/${PACO_TAG}/paco_${PACO_VERSION}_linux_${TARGETARCH_VAL}.tar.gz" | \
    tar -xz -C /usr/local/bin paco && \
    chmod +x /usr/local/bin/paco

# Verify installations
RUN codex --version && \
    claude --version && \
    gemini --version && \
    agy --version && \
    opencode --version && \
    paco version && \
    copilot --version && \
    pi --version && \
    ast-grep --version && \
    sg --version && \
    yq --version && \
    gh --version && \
    glab --version && \
    kubectl version --client && \
    stern --version && \
    rg --version && \
    fd --version && \
    make --version && \
    jq --version && \
    shellcheck --version

# Final runtime stage
FROM alpine:latest

# Environment variables
ENV NODE_ENV=production \
    USE_BUILTIN_RIPGREP=0 \
    PATH="/user/.local/bin:${PATH}"

# Install runtime dependencies, developer utilities, GitHub CLI and Node.js from Alpine repos
RUN apk add --no-cache \
        bash \
        ca-certificates \
        curl \
        git \
        xz \
        libgcc \
        libstdc++ \
        ripgrep \
        fd \
        make \
        jq \
        shellcheck \
        github-cli \
        ast-grep \
        nodejs \
        npm

# Copy installed tools from builder stage
COPY --from=builder /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=builder /usr/local/bin /usr/local/bin

# Create aiuser with UID/GID 1000
RUN addgroup -g 1000 aiuser && \
    adduser -D -u 1000 -G aiuser -h /user -s /bin/bash aiuser && \
    chown -R aiuser:aiuser /user

# Set default user
USER aiuser
WORKDIR /user

# Add labels for GitHub Container Registry
LABEL org.opencontainers.image.source="https://github.com/nqbao/cli-agents-container"
LABEL org.opencontainers.image.description="Alpine-based multi-arch image with AI coding assistants (Codex, Claude Code, Gemini CLI, Antigravity CLI, OpenCode, Pi) and other developer tools"
LABEL org.opencontainers.image.licenses="MIT"

# Default command
CMD ["/bin/bash"]
